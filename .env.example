# ─────────────────────────────────────────────────────────────────────────────
# DaraTech Bot — environment variables
# Copy this file to .env and fill in your values.
# Never commit your real .env to GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# ── SESSION ──────────────────────────────────────────────────────────────────
# Paste the SESSION_ID generated during pairing here.
SESSION_ID=

# ── PAIRING NUMBER (required) ────────────────────────────────────────────────
# Your WhatsApp number in international format, digits only (no + or spaces).
# This is the number that will receive the pairing code and act as the local
# bot owner — grants access to owner commands ($mode, $autoupdate, etc.).
# Example: 2348012345678
PAIRING_NUMBER=

# ── BOT DISPLAY NAME ─────────────────────────────────────────────────────────
# Optional: override the bot's display name shown in greetings.
NAME=
