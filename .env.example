# ═══════════════════════════════════════════════════════════════
#  Daratech Bot — Environment Variables
#  Copy this file to .env and fill in your values.
#  In Replit: add these as Secrets (the padlock icon), not in a
#  .env file — Replit injects them into process.env automatically.
# ═══════════════════════════════════════════════════════════════


# ── PRIMARY SESSION (Bot 1) ────────────────────────────────────
#
# Phone number of the WhatsApp account you are linking.
# International format, digits only — no +, no spaces.
# Example: 2348012345678  (Nigeria)
#          447911123456   (UK)
#          15551234567    (US)
OWNER_NUMBER=

# Base64-encoded session credentials.
# Leave EMPTY on first run — the bot fills this in automatically
# after you scan the QR / enter the pairing code.
# Once set, .update and restarts will never ask you to reconnect.
SESSION_ID=

# ── ADDITIONAL SESSIONS (Bot 2, 3, …) ─────────────────────────
#
# Repeat the three vars below for each extra bot you want to run
# simultaneously.  N = 2, 3, 4, … (up to 20 supported).
#
# BOT_N_NAME    — display name shown in $bots and greetings
# BOT_N_NUMBER  — phone number of that WhatsApp account (digits only)
# BOT_N_SESSION — base64 session creds (auto-filled after first pair)
#
# Example — second bot called "Kaevra":
# BOT_2_NAME=Kaevra
# BOT_2_NUMBER=2347012345678
# BOT_2_SESSION=
#
# Example — third bot called "Viora":
# BOT_3_NAME=Viora
# BOT_3_NUMBER=447912345678
# BOT_3_SESSION=
#
# NOTE: BOT_1_* is an alias for the primary session above.
#       You can use either BOT_1_NAME / BOT_1_SESSION  or
#       OWNER_NUMBER / SESSION_ID — they map to the same slot.

BOT_2_NAME=
BOT_2_NUMBER=
BOT_2_SESSION=

BOT_3_NAME=
BOT_3_NUMBER=
BOT_3_SESSION=
